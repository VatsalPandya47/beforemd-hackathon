# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=live
ALLOW_FIXTURE_FALLBACK=true

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Medplum
MEDPLUM_BASE_URL=https://api.medplum.com/
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=
DEMO_PATIENT_FHIR_ID=
DEMO_ENCOUNTER_FHIR_ID=
DEMO_APPOINTMENT_FHIR_ID=

# Deepgram
DEEPGRAM_API_KEY=

# Moss — Control Plane API at https://service.usemoss.dev/v1/manage.
# Auth: header x-project-key (the project key below), x-service-version: v1,
# and projectId in the JSON body. See docs/sponsor-notes.md for a verified
# example request (moss.ts still needs the real adapter wiring — issue #12).
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# Stedi
STEDI_API_KEY=
STEDI_BASE_URL=https://healthcare.us.stedi.com/2024-04-01

# LLM — via Vercel AI Gateway, no key needed. Auth is via VERCEL_OIDC_TOKEN
# (provisioned automatically by `vercel env pull`, refreshed via `vercel link`
# + `vercel env pull` again after ~24h locally; auto-refreshed on Vercel deploys).
# Pass plain "provider/model" strings to the `ai` SDK, e.g. "openai/gpt-5-nano".
LLM_MODEL=openai/gpt-5-nano
# Kill switch. Set false to force scripted questions and the demo draft fixture
# without touching code. Defaults true; any live-call failure already falls back.
USE_LIVE_LLM=true

# Feature flags
USE_LIVE_MEDPLUM=true
USE_LIVE_DEEPGRAM=true
USE_LIVE_MOSS=true
USE_LIVE_STEDI=true
