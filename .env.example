# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=live
ALLOW_FIXTURE_FALLBACK=true

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Medplum
MEDPLUM_BASE_URL=https://api.medplum.com/
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=
DEMO_PATIENT_FHIR_ID=
DEMO_ENCOUNTER_FHIR_ID=
DEMO_APPOINTMENT_FHIR_ID=

# Deepgram
DEEPGRAM_API_KEY=

# Moss — retrieval runs through the @inferedge/moss SDK, which builds the index
# in Moss cloud and then queries it on-device. The Control Plane API at
# https://service.usemoss.dev/v1/manage has no search action; the SDK is the
# only retrieval path. See docs/sponsor-notes.md.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
# Index the adapter loads and queries. Created automatically on first use if it
# does not exist (developer plan allows 3 indexes per project).
MOSS_INDEX_NAME=beforemd-clinical-context

# Stedi
STEDI_API_KEY=
STEDI_BASE_URL=https://healthcare.us.stedi.com/2024-04-01
# Test-mode identities. Defaults in stedi.ts match the verified sandbox payload
# in docs/sponsor-notes.md (Aetna payer 60054, member AETNA12345, Stedi's test
# NPI). Override only if the sandbox account changes.
STEDI_TRADING_PARTNER_ID=60054
STEDI_TEST_MEMBER_ID=AETNA12345
STEDI_TEST_FIRST_NAME=Jane
STEDI_TEST_LAST_NAME=Doe
STEDI_PROVIDER_ORG=BeforeMD
STEDI_PROVIDER_NPI=1999999984

# LLM — via Vercel AI Gateway, no key needed. Auth is via VERCEL_OIDC_TOKEN
# (provisioned automatically by `vercel env pull`, refreshed via `vercel link`
# + `vercel env pull` again after ~24h locally; auto-refreshed on Vercel deploys).
# Pass plain "provider/model" strings to the `ai` SDK, e.g. "openai/gpt-5-nano".
LLM_MODEL=openai/gpt-5-nano
# Kill switch. Set false to force scripted questions and the demo draft fixture
# without touching code. Defaults true; any live-call failure already falls back.
USE_LIVE_LLM=true

# Feature flags
USE_LIVE_MEDPLUM=true
USE_LIVE_DEEPGRAM=true
USE_LIVE_MOSS=true
USE_LIVE_STEDI=true
